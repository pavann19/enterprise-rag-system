# Copy this file to .env and fill in real values there. .env is gitignored —
# never commit actual keys. docker-compose.yml reads .env automatically.

# Embedding backend: "ollama" (default, local) or "local" (sentence-transformers)
EMBED_BACKEND=
EMBED_MODEL=

# Generation backend: "ollama" (default, local), "anthropic", or "groq"
GEN_BACKEND=
GEN_MODEL=

# Vector store backend: "numpy" (default), "faiss", or "qdrant"
VECTOR_BACKEND=

# Required only if GEN_BACKEND=anthropic
ANTHROPIC_API_KEY=

# Required only if GEN_BACKEND=groq
GROQ_API_KEY=

# Where rag/_http.py sends Ollama requests. Leave unset for bare-metal/venv
# use (defaults to http://localhost:11434); docker-compose.yml sets this to
# http://ollama:11434 itself, so you don't need to set it here for Docker.
OLLAMA_HOST=

# How many chunks rag/embedder.py embeds concurrently against Ollama
# (default 8). Ollama has no batch-embeddings endpoint — this is what
# turns a serial request-per-chunk loop into overlapping requests. See
# eval/benchmark_scale.py for the measured effect (~8x at concurrency=8).
EMBED_CONCURRENCY=

# Transient-failure retries for every Ollama call (default 2 = 3 attempts
# total, 0.5s/1s backoff). Applies per HTTP call, so it compounds across a
# large corpus's independent per-chunk embedding calls during a full
# outage — see rag/_http.py's docstring comment for the measured worst case.
OLLAMA_MAX_RETRIES=

# service/api.py: max POST /query requests per client IP per minute
# (default 30). Only /query is limited — /health and /ready are meant to
# be polled freely.
RATE_LIMIT_PER_MINUTE=

# service/api.py: shared secret required in the X-API-Key header on
# POST /query and /query/stream. Unset by default (unauthenticated) —
# set this before exposing the service beyond localhost. /health and
# /ready never require it.
RAG_API_KEY=

# service/rate_limiter.py: Redis connection string (e.g.
# redis://localhost:6379/0). Set this only if running more than one
# api worker/replica — see get_rate_limiter()'s docstring. Unset (default)
# uses the in-memory limiter, correct for a single process. Requires the
# optional `redis` package — see requirements.txt.
REDIS_URL=

# rag/reranker.py: "1"/"true" to re-score retrieve()'s top-k results with
# a cross-encoder before generation (better precision, added latency +
# a one-time model download). Default off.
RERANK_ENABLED=
