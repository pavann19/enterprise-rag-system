# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Streamlit cache
.streamlit/

# Ollama / model weights (never commit large binaries)
*.bin
*.gguf
*.safetensors

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code local dev config (preview server definitions, etc.) —
# machine-specific, not part of the product
.claude/

# Numpy saved arrays (generated at runtime)
*.npy
*.npz

# Persisted corpus cache (rag/ingestion.py cache_dir) — regenerated on demand
.cache/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Evaluation run output (eval/run_eval.py) — regenerated on demand
eval/results/

# Local secrets — API keys belong here or in a real secrets manager,
# never in a tracked file. docker-compose.yml and .streamlit/secrets.toml
# both read from this / an equivalent local-only source.
.env
.env.*
!.env.example
.streamlit/secrets.toml
