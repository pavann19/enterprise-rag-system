# Copy to .env.local for local development. Next.js only exposes vars
# prefixed NEXT_PUBLIC_ to the browser bundle — see src/lib/api.ts.

# Where service/api.py is running. Must also be in that service's
# CORS_ALLOWED_ORIGINS (see ../.env.example) or the browser will block the
# request even with this set correctly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Only needed if the backend has RAG_API_KEY set.
NEXT_PUBLIC_API_KEY=
